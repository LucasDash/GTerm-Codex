<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Company>Earu</Company>
    <Product>GTerm</Product>
    <Description>Garry's Mod external console software with MCP and Websocket support.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Fully managed: no native assets, so the self-contained single-file publish stays per-RID clean. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.*" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="VdfConverter" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Runtime settings and package consent live beside the executable. Seed a
       new output only once; later builds and publishes must preserve it. -->
  <Target Name="SeedInitialBuildConfig" AfterTargets="Build"
          Condition="'$(TargetDir)' != '' and Exists('$(MSBuildProjectDirectory)\Config.json') and !Exists('$(TargetDir)Config.json')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Config.json" DestinationFiles="$(TargetDir)Config.json" />
  </Target>

  <Target Name="SeedInitialPublishConfig" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and Exists('$(MSBuildProjectDirectory)\Config.json') and !Exists('$(PublishDir)Config.json')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Config.json" DestinationFiles="$(PublishDir)Config.json" />
  </Target>

  <!-- Previous builds tracked Config.json as disposable output. Remove just
       that entry so upgrade cleanup and dotnet clean cannot delete consent. -->
  <Target Name="PreserveRuntimeConfigFromBuildCleanup"
          BeforeTargets="_CleanGetCurrentAndPriorFileWrites;CoreClean"
          Condition="'$(TargetDir)' != '' and Exists('$(IntermediateOutputPath)$(CleanFile)')">
    <ReadLinesFromFile File="$(IntermediateOutputPath)$(CleanFile)">
      <Output TaskParameter="Lines" ItemName="_GTermPriorTrackedWrites" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_GTermPriorTrackedWrites Remove="$(TargetDir)Config.json" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)$(CleanFile)"
                      Lines="@(_GTermPriorTrackedWrites)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
